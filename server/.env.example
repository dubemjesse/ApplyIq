# Server
# NOTE: 5001/5433/6380 are used instead of the usual 5000/5432/6379 to avoid
# colliding with other local services. Adjust freely if your machine is clear.
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (matches docker-compose postgres service host mapping)
DATABASE_URL="postgresql://applyiq:applyiq@localhost:5433/applyiq"

# Redis (Bull queues)
REDIS_URL="redis://localhost:6380"

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Comma-separated emails that get the ADMIN role automatically on registration
# (bootstrap mechanism — there's no other way to create the first admin).
ADMIN_EMAILS=

# AI provider — powers matcher.js, generator.js, and followupWriter.js
ANTHROPIC_API_KEY=

# Job search APIs (optional alternative to scraping)
RAPIDAPI_KEY=

# Email (Nodemailer/SendGrid) — used by emailService.js for follow-up emails
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=
SMTP_FROM=noreply@applyiq.example

# Puppeteer
PUPPETEER_HEADLESS=true
